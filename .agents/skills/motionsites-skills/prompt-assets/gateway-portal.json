    {
      "name": "Standalone HTML (Code)",
      "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Step Into Wonder</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Viaoda+Libre&family=Imprima&family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n  <link href=\"https://db.onlinewebfonts.com/c/e2bba9cf49b298d6be781c2274694ea3?family=Mr+Dafoe+Regular\" rel=\"stylesheet\" />\n  <link href=\"https://db.onlinewebfonts.com/c/0976a2619014c5855690b7509fab4c6e?family=Helvetica+Now+Display\" rel=\"stylesheet\" />\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; padding: 0; background: #0a0608; scroll-behavior: auto; overflow-x: clip; }\n    html { scrollbar-gutter: stable; }\n    body { font-family: 'Helvetica Now Display', 'Inter', sans-serif; -webkit-font-smoothing: antialiased; }\n    @keyframes bobUp { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }\n    button { font-family: inherit; }\n    .hns { font-family: 'Helvetica Now Display', sans-serif; }\n    .dafoe { font-family: 'Mr Dafoe Regular', cursive; }\n\n    /* World background (fixed) */\n    #worldLayer { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #0a0608; }\n    #world { position: absolute; inset: 0; transform-origin: 50% 50%; transform: scale(1); will-change: transform; }\n    #world img { width: 100%; height: 100%; object-fit: cover; display: block; }\n\n    /* Nav */\n    nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; padding: 26px 40px; }\n    .wordmark { display: inline-flex; align-items: baseline; color: #fff; line-height: 1; }\n    .wordmark .aura { font-size: 36px; margin-right: 1px; }\n    .wordmark .gate { font-weight: 500; font-size: 24px; letter-spacing: -0.02em; }\n    .nav-actions { display: flex; align-items: center; gap: 0; }\n    .demo-btn { font-size: 13px; font-weight: 600; color: #161616; background: #fff; border: none; border-radius: 999px; padding: 11px 22px; cursor: pointer; white-space: nowrap; transition: background .25s ease; }\n    .demo-btn:hover { background: #e6e6e6; }\n    .menu-btn { width: 42px; height: 42px; border-radius: 50%; background: #fff; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: background .25s ease; }\n    .menu-btn:hover { background: #e6e6e6; }\n\n    /* Intro track */\n    #introTrack { position: relative; height: 160vh; z-index: 5; }\n    #introStage { position: sticky; top: 0; width: 100%; height: 100vh; overflow: hidden; }\n    #portal { position: absolute; inset: 0; z-index: 15; transform-origin: 52% 38%; transform: scale(1); will-change: transform, opacity; }\n    #portal img { width: 100%; height: 100%; object-fit: cover; display: block; }\n    #scene1 { position: absolute; inset: 0; z-index: 20; transition: opacity .1s linear; }\n    #scene1Inner { position: absolute; left: 0; right: 0; bottom: 0; display: flex; flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 80px; padding: 0 44px 52px; opacity: 0; transform: translateY(24px); transition: opacity 1s ease, transform 1s ease; transition-delay: .3s; }\n    #scene1Inner.show { opacity: 1; transform: translateY(0); }\n    .hero-col1 { text-align: left; max-width: 560px; }\n    .hero-col1 h1 { font-weight: 500; color: #fff; margin: 0; line-height: 1.04; letter-spacing: -0.02em; font-size: clamp(40px, 4vw, 58px); }\n    .hero-col1 h1 .discover { font-weight: 400; color: #9a9a9a; letter-spacing: 0; font-size: 1.15em; margin-right: 0.12em; }\n    .hero-col1 p { font-weight: 400; font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.5); margin: 18px 0 0; max-width: 340px; }\n    .hero-col2 { display: flex; align-items: center; gap: 14px; text-align: left; }\n    .hero-col2 .bigA { font-size: 64px; color: #fff; line-height: 0.8; flex-shrink: 0; }\n    .hero-col2 p { font-weight: 400; font-size: 11px; line-height: 1.5; color: rgba(255,255,255,0.5); margin: 0; max-width: 150px; }\n\n    /* Section 2 */\n    #section2 { position: relative; z-index: 10; }\n    .s2-wrap { display: flex; flex-direction: column; align-items: center; padding-top: 14vh; padding-bottom: 60px; }\n    .s2-head { text-align: center; padding: 0 20px; }\n    .s2-head h2 { font-weight: 500; font-size: clamp(34px, 4vw, 52px); color: #fff; letter-spacing: -0.02em; line-height: 1.1; margin: 0; text-shadow: 0 2px 20px rgba(0,0,0,0.35); }\n    .s2-head p { font-weight: 500; font-size: 17px; line-height: 1.55; letter-spacing: -0.01em; margin: 16px auto 0; max-width: 420px; color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.3); }\n    .carousel-mount { display: flex; justify-content: center; align-items: flex-end; width: 100%; margin-top: 6vh; }\n\n    /* Carousel */\n    .carousel { position: relative; width: 100%; height: 560px; }\n    .card { position: absolute; top: 50%; left: 50%; width: 300px; height: 420px; margin-left: -150px; margin-top: -210px; transform-origin: center center; transition: transform .55s cubic-bezier(0.22,1,0.36,1), opacity .55s ease; will-change: transform, opacity; }\n    .card-face { width: 100%; height: 100%; border-radius: 28px; padding: 34px 30px; display: flex; align-items: center; justify-content: center; text-align: center; }\n    .card-face.inactive { background: linear-gradient(135deg, rgba(255,255,255,0.42) 0%, rgba(255,255,255,0.24) 100%); -webkit-backdrop-filter: blur(18px) saturate(140%); backdrop-filter: blur(18px) saturate(140%); border: 1px solid rgba(255,255,255,0.28); box-shadow: inset 0 1px 1px rgba(255,255,255,0.45); }\n    .card-face.center { background: rgb(247,251,255); border: 1px solid rgba(255,255,255,0.6); box-shadow: 0 8px 24px rgba(0,0,0,0.08), 0 0 50px rgba(255,255,255,0.55), 0 0 90px rgba(255,255,255,0.35); }\n    .card-face p { font-weight: 500; font-size: 17px; line-height: 1.5; letter-spacing: -0.01em; margin: 0; }\n    .card-face.inactive p { color: rgba(255,255,255,0.85); }\n    .card-face.center p { color: #2c2420; }\n    .carousel-nav { position: absolute; bottom: -40px; left: 50%; transform: translateX(-50%); display: flex; gap: 10px; z-index: 200; }\n    .nav-circle { width: 46px; height: 46px; border-radius: 50%; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: opacity .25s ease, transform .2s ease; }\n    .nav-circle.prev { background: rgba(255,255,255,0.2); }\n    .nav-circle.next { background: rgba(255,255,255,0.9); box-shadow: 0 6px 18px rgba(0,0,0,0.18); }\n    .nav-circle.prev svg { filter: drop-shadow(rgba(255,255,255,0.7) 0px 0px 6px) drop-shadow(rgba(255,255,255,0.4) 0px 0px 14px); }\n\n    /* Footer */\n    footer { position: relative; padding: 160px 44px 52px; }\n    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; max-width: 1280px; margin: 0 auto; }\n    .footer-brand p { font-weight: 400; font-size: 12px; line-height: 1.6; color: rgba(255,255,255,0.55); margin: 20px 0 0; }\n    .footer-col .title { font-weight: 500; font-size: 13px; letter-spacing: 0.01em; color: rgba(255,255,255,0.55); margin: 0 0 18px; }\n    .footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }\n    .footer-col a { font-weight: 500; font-size: 14px; color: #fff; text-decoration: none; transition: opacity .2s ease; }\n    .footer-col a:hover { opacity: 0.65; }\n\n    /* Mobile */\n    @media (max-width: 767px) {\n      nav { padding: 18px 20px; }\n      .wordmark .aura { font-size: 30px; }\n      .wordmark .gate { font-size: 20px; }\n      .demo-btn { font-size: 12px; padding: 9px 16px; }\n      .menu-btn { width: 38px; height: 38px; }\n      #scene1Inner { flex-direction: column; align-items: stretch; gap: 48px; padding: 0 22px 40px; }\n      .hero-col1 { max-width: 100%; }\n      .hero-col1 h1 { font-size: clamp(30px, 9vw, 44px); }\n      .hero-col1 p { font-size: 13px; }\n      .hero-col2 { display: none; }\n      .s2-wrap { padding-top: 12vh; padding-bottom: 40px; }\n      .s2-head h2 { font-size: clamp(26px, 7vw, 38px); }\n      .s2-head p { font-size: 14px; max-width: 280px; }\n      .carousel-mount { margin-top: 5vh; }\n      .carousel { height: 460px; }\n      .card { width: 230px; height: 320px; margin-left: -115px; margin-top: -160px; }\n      .card-face { border-radius: 22px; padding: 24px 22px; }\n      .card-face p { font-size: 15px; }\n      .carousel-nav { bottom: -44px; }\n      .nav-circle { width: 42px; height: 42px; }\n      footer { padding: 120px 22px 40px; }\n      .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px 20px; }\n      .footer-brand { grid-column: 1 / -1; }\n    }\n  </style>\n</head>\n<body>\n  <div id=\"root\" style=\"position: relative; background: #0a0608;\">\n    <!-- World background -->\n    <div id=\"worldLayer\">\n      <div id=\"world\">\n        <img id=\"worldImg\" alt=\"\" />\n      </div>\n    </div>\n\n    <!-- Nav -->\n    <nav>\n      <span class=\"wordmark\"><span class=\"dafoe aura\">Aura</span><span class=\"hns gate\">gate</span></span>\n      <div class=\"nav-actions\">\n        <button class=\"demo-btn hns\">Watch Demo</button>\n        <button class=\"menu-btn\" aria-label=\"Menu\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M2 5h12M2 11h12\" stroke=\"#161616\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg>\n        </button>\n      </div>\n    </nav>\n\n    <!-- Intro track -->\n    <div id=\"introTrack\">\n      <div id=\"introStage\">\n        <div id=\"portal\"><img id=\"portalImg\" alt=\"\" /></div>\n        <div id=\"scene1\">\n          <div id=\"scene1Inner\">\n            <div class=\"hero-col1\">\n              <h1 class=\"hns\"><span class=\"dafoe discover\">Discover</span>Living<br/>Digital Worlds<br/>Vivid, Alive, Endless</h1>\n              <p class=\"hns\">Experience immersive worlds with stories that blur the line between imagination, AI and living reality made for you.</p>\n            </div>\n            <div class=\"hero-col2\">\n              <span class=\"dafoe bigA\">A.</span>\n              <p class=\"hns\">A studio is a trusted partner in your journey through wonderland.</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Section 2 -->\n    <section id=\"section2\">\n      <div class=\"s2-wrap\">\n        <div class=\"s2-head\">\n          <h2 class=\"hns\">Real wonders.<br/>Real worlds.</h2>\n          <p class=\"hns\">See how Auragate helps others, and find out what it can do for you.</p>\n        </div>\n        <div class=\"carousel-mount\">\n          <div class=\"carousel\" id=\"carousel\">\n            <div class=\"carousel-nav\">\n              <button class=\"nav-circle prev\" aria-label=\"Previous\" data-dir=\"-1\">\n                <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M9 2L4 7l5 5\" stroke=\"#ffffff\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              </button>\n              <button class=\"nav-circle next\" aria-label=\"Next\" data-dir=\"1\">\n                <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M5 2l5 5-5 5\" stroke=\"#2c2420\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <footer>\n        <div class=\"footer-grid\">\n          <div class=\"footer-brand\">\n            <span class=\"wordmark\"><span class=\"dafoe aura\">Aura</span><span class=\"hns gate\">gate</span></span>\n            <p class=\"hns\">&copy; 2026 Auragate</p>\n          </div>\n          <div class=\"footer-col\">\n            <p class=\"title hns\">Explore</p>\n            <ul><li><a class=\"hns\" href=\"#\">How it works</a></li><li><a class=\"hns\" href=\"#\">Features</a></li></ul>\n          </div>\n          <div class=\"footer-col\">\n            <p class=\"title hns\">Contact</p>\n            <ul><li><a class=\"hns\" href=\"#\">X (Twitter)</a></li><li><a class=\"hns\" href=\"#\">hello@auragate.com</a></li></ul>\n          </div>\n          <div class=\"footer-col\">\n            <p class=\"title hns\">Legal</p>\n            <ul><li><a class=\"hns\" href=\"#\">Privacy Policy</a></li><li><a class=\"hns\" href=\"#\">Terms of Service</a></li></ul>\n          </div>\n        </div>\n      </footer>\n    </section>\n  </div>\n\n  <script>\n    var PORTAL_BG = 'https://res.cloudinary.com/dy5er7kv5/image/upload/q_auto/f_auto/v1781046673/image_1_ksxfzb.png';\n    var WORLD_BG = 'https://images.higgs.ai/?default=1&output=webp&url=https%3A%2F%2Fd8j0ntlcm91z4.cloudfront.net%2Fuser_38xzZboKViGWJOttwIXH07lWA1P%2Fhf_20260609_231253_53c0854c-d13c-42c1-9fc0-17e87cd34091.png&w=1280&q=85';\n    document.getElementById('worldImg').src = WORLD_BG;\n    document.getElementById('portalImg').src = PORTAL_BG;\n\n    var QUOTES = [\n      'It is amazing to see and feel the worlds I am stepping into each day.',\n      'I have been feeling much more alive inside these living worlds, even on the long days.',\n      'My wonder has been growing so fast that it is hard to believe the difference. Auragate gave me exactly the vision I needed.',\n      'The first two scenes felt alive. I tried everything we dreamed up and it worked.',\n      'The wonder of it all really moved me, it even brought a tear to my eyes every time.',\n      'I finally feel immersed, like the worlds were built just for me.',\n      'Stepping into it was effortless and the worlds have been unlike anything I dreamt.'\n    ];\n\n    function easeInOut(t){ return t < 0.5 ? 2*t*t : -1 + (4-2*t)*t; }\n    function lerp(a,b,t){ return a + (b-a)*t; }\n    function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }\n    function isMobile(){ return window.innerWidth < 768; }\n\n    var MAG = { world: 6, portal: 7 };\n\n    var introTrack = document.getElementById('introTrack');\n    var world = document.getElementById('world');\n    var portal = document.getElementById('portal');\n    var scene1 = document.getElementById('scene1');\n    var scene1Inner = document.getElementById('scene1Inner');\n\n    var scrollProgress = 0;\n    var mouseRaw = { x: 0, y: 0 };\n    var mouseSmooth = { x: 0, y: 0 };\n\n    setTimeout(function(){ scene1Inner.classList.add('show'); }, 600);\n\n    function handleScroll(){\n      var pinScroll = Math.max(1, introTrack.offsetHeight - window.innerHeight);\n      scrollProgress = clamp(window.scrollY / pinScroll, 0, 1);\n      var portalOpacity = scrollProgress < 0.66 ? 1 : clamp(1 - (scrollProgress - 0.66) / 0.22, 0, 1);\n      var scene1Opacity = clamp(1 - scrollProgress / 0.22, 0, 1);\n      portal.style.opacity = portalOpacity;\n      scene1.style.opacity = scene1Opacity;\n      scene1.style.pointerEvents = scene1Opacity < 0.05 ? 'none' : 'auto';\n    }\n    handleScroll();\n    window.addEventListener('scroll', handleScroll, { passive: true });\n    window.addEventListener('resize', handleScroll);\n\n    window.addEventListener('mousemove', function(e){\n      mouseRaw.x = (e.clientX / window.innerWidth - 0.5) * 2;\n      mouseRaw.y = (e.clientY / window.innerHeight - 0.5) * 2;\n    }, { passive: true });\n\n    function tick(){\n      var speed = 0.07;\n      mouseSmooth.x = lerp(mouseSmooth.x, mouseRaw.x, speed);\n      mouseSmooth.y = lerp(mouseSmooth.y, mouseRaw.y, speed);\n      var rx = -mouseSmooth.x, ry = -mouseSmooth.y;\n      var ep = easeInOut(scrollProgress);\n\n      var wScale = lerp(1, 1.18, ep);\n      world.style.transform = 'scale(' + wScale + ') translate(' + (rx*MAG.world) + 'px,' + (ry*MAG.world) + 'px)';\n\n      var pScale = lerp(1, 7.5, ep);\n      portal.style.transform = 'scale(' + pScale + ') translate(' + (rx*MAG.portal) + 'px,' + (ry*MAG.portal) + 'px)';\n\n      requestAnimationFrame(tick);\n    }\n    requestAnimationFrame(tick);\n\n    /* Carousel */\n    var carousel = document.getElementById('carousel');\n    var total = QUOTES.length;\n    var half = Math.floor(total / 2);\n    var active = Math.floor(total / 2);\n    var cardEls = [];\n\n    for (var i = 0; i < total; i++) {\n      var card = document.createElement('div');\n      card.className = 'card';\n      var face = document.createElement('div');\n      face.className = 'card-face';\n      var p = document.createElement('p');\n      p.className = 'hns';\n      p.innerHTML = '\\u201C' + QUOTES[i] + '\\u201D';\n      face.appendChild(p);\n      card.appendChild(face);\n      carousel.insertBefore(card, carousel.firstChild);\n      cardEls.push({ card: card, face: face });\n    }\n\n    function renderCarousel(){\n      var mobile = isMobile();\n      var stepX = mobile ? 170 : 295;\n      var dropY = mobile ? 34 : 52;\n      var tilt = mobile ? 7 : 8;\n      var centerBump = mobile ? 22 : 30;\n      for (var i = 0; i < total; i++) {\n        var pos = ((i - active) % total + total) % total;\n        if (pos > half) pos -= total;\n        var abs = Math.abs(pos);\n        var isCenter = pos === 0;\n        var opacity = isCenter ? 1 : Math.max(0, 0.6 - (abs - 1) * 0.2);\n        var el = cardEls[i];\n        el.card.style.transform = 'translateX(' + (pos*stepX) + 'px) translateY(' + (abs*dropY + (isCenter ? centerBump : 0)) + 'px) rotate(' + (pos*tilt) + 'deg)';\n        el.card.style.opacity = opacity;\n        el.card.style.zIndex = 100 - abs;\n        el.card.style.pointerEvents = isCenter ? 'auto' : 'none';\n        el.face.className = 'card-face ' + (isCenter ? 'center' : 'inactive');\n      }\n    }\n    renderCarousel();\n    window.addEventListener('resize', renderCarousel);\n\n    var navButtons = carousel.querySelectorAll('.nav-circle');\n    for (var b = 0; b < navButtons.length; b++) {\n      navButtons[b].addEventListener('click', function(){\n        var dir = parseInt(this.getAttribute('data-dir'), 10);\n        active = ((active + dir) % total + total) % total;\n        renderCarousel();\n      });\n    }\n  </script>\n</body>\n</html>"
    }
  ],
  "section_names": []
}